# Copy to /opt/waka/.env on the server and fill in. Never commit the real file.

# --- Stack (read by compose.yaml) ---
DOMAIN=yourdomain.com
DB_ROOT_PASSWORD=change-me-root

# --- App ---
APP_NAME="Waka Shots"
APP_ENV=production
# Reuse your local APP_KEY if you import the local database; otherwise: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Database (host is the compose service name) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=waka_shots
DB_USERNAME=waka
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# --- Mail (Resend) ---
MAIL_MAILER=resend
RESEND_API_KEY=
# Must be on a domain verified in Resend, or real clients won't receive mail.
MAIL_FROM_ADDRESS=hello@yourdomain.com
MAIL_FROM_NAME="Waka Shots Photography"

# --- Cloudflare R2 (portfolio/partner/service images) ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_URL=

# --- Google Drive (client galleries) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourdomain.com/auth/google/callback
